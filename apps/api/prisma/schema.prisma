// TRIPLY database schema (spec §24–26).
// UUID primary keys everywhere — nothing sequential is ever exposed publicly.
// Soft deletion (deletedAt) for users, trips, posts and comments.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

/// ACTIVE = shown everywhere · CLOSED = permanently closed (kept so old itineraries still resolve) · HIDDEN = hidden by an admin.
enum PlaceStatus {
  ACTIVE
  CLOSED
  HIDDEN
}

enum GeoAreaLevel {
  COUNTRY
  REGION
  CITY
  DISTRICT
}

enum TripVisibility {
  PRIVATE
  LINK_ONLY
  PUBLIC
}

enum TripRole {
  OWNER
  EDITOR
  VIEWER
}

enum ItemType {
  PLACE
  RESTAURANT
  HOTEL
  FLIGHT
  TRANSPORTATION
  ACTIVITY
  NOTE
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  DRAFT
}

enum TravelerType {
  SOLO
  COUPLE
  FRIENDS
  FAMILY
  ALL
}

enum NotificationType {
  TRIP_INVITE
  TRIP_ITEM_ADDED
  TRIP_ITEM_UPDATED
  TRIP_MEMBER_ROLE_CHANGED
  COMMENT
  LIKE
  FOLLOW
  TRIP_SAVED
  TRIP_FORKED
}

enum ReportTarget {
  POST
  COMMENT
  USER
  TRIP
  PLACE_PHOTO
}

/// PENDING: waiting for a moderator (new uploaders, loose matches). HIDDEN: removed by a moderator or by reports.
enum PhotoStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISLEADING
  OTHER
}

// ── Users ────────────────────────────────────────────────────────────────
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  username         String    @unique
  /// Null for accounts created through Google sign-in until a password is set.
  passwordHash     String?   @map("password_hash")
  isDemo           Boolean   @default(false) @map("is_demo")
  role             UserRole  @default(USER)
  /// Set once the user proves they own `email` (link in a verification email, or Google sign-in).
  emailVerifiedAt  DateTime? @map("email_verified_at")
  /// Per-account brute-force protection (independent of the client IP).
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  profile         UserProfile?
  oauthAccounts   OAuthAccount[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
  ownedTrips      Trip[]                   @relation("TripOwner")
  memberships     TripMember[]
  posts           Post[]
  comments        PostComment[]
  likes           PostLike[]
  following       Follow[]                 @relation("Follower")
  followers       Follow[]                 @relation("Following")
  savedTrips      SavedTrip[]
  savedPosts      SavedPost[]
  savedPlaces     SavedPlace[]
  notifications   Notification[]           @relation("Recipient")
  actedNotifs     Notification[]           @relation("Actor")
  media           Media[]
  reports         Report[]
  placePhotos     PlacePhoto[]
  invitationsBy   TripInvitation[]         @relation("Inviter")
  itemsEdited     ItineraryItem[]          @relation("ItemEditor")
  itemsAdded      ItineraryItem[]          @relation("ItemAdder")
  itemPhotos      ItemPhoto[]              @relation("ItemPhotoUploader")
  itemAssignments ItemAssignee[]
  expensesPaid    Expense[]                @relation("ExpensePayer")
  expensesMade    Expense[]                @relation("ExpenseCreator")
  expenseShares   ExpenseShare[]
  settlementsFrom Settlement[]             @relation("SettlementFrom")
  settlementsTo   Settlement[]             @relation("SettlementTo")
  settlementsMade Settlement[]             @relation("SettlementCreator")
  itemVotes       ItemVote[]
  tripEvents      TripEvent[]
  auditLogs       AuditLog[]
  syncJobs        SyncJob[]
  syncRuns        SyncRun[]
  placeEdits      PlaceEdit[]

  @@map("users")
  productEvents   ProductEvent[]
}

model UserProfile {
  userId           String        @id @map("user_id") @db.Uuid
  displayName      String        @map("display_name")
  bio              String        @default("")
  homeBase         String?       @map("home_base")
  avatarHue        Int           @default(180) @map("avatar_hue")
  avatarMediaId    String?       @map("avatar_media_id") @db.Uuid
  travelerType     TravelerType? @map("traveler_type")
  interests        String[]      @default([])
  onboardedAt      DateTime?     @map("onboarded_at")
  /// Interface language ("en" | "vi", CHECK in the migration); null = never chosen.
  locale           String?
  /// Opt-in: this user's trip activity may be used (pseudonymised) to improve planning suggestions.
  analyticsConsent Boolean       @default(false) @map("analytics_consent")
  /// Lower-cased, accent-free "display name username home base" for fuzzy search.
  searchText       String        @default("") @map("search_text")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar Media? @relation("Avatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("user_profiles")
}

/// External identity providers linked to a user (Google today).
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Refresh-token sessions. Only a SHA-256 hash of the token is stored.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  /// The refresh token this one replaced: a replay outside the grace window means it was stolen.
  prevTokenHash String?   @unique @map("prev_token_hash")
  rotatedAt     DateTime? @map("rotated_at")
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// The address being verified — a token stops working if the user's email changes.
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ── Destinations & places ───────────────────────────────────────────────
model Destination {
  id               String  @id @default(uuid()) @db.Uuid
  slug             String  @unique
  name             String
  country          String
  lat              Float
  lng              Float
  blurb            String  @default("")
  paletteA         String  @map("palette_a")
  paletteB         String  @map("palette_b")
  /// Accent-free "name country" for fuzzy search ("hoi an" finds "Hội An").
  searchText       String  @default("") @map("search_text")
  /// The smallest administrative area containing the destination's centre (Hội An → Đà Nẵng).
  areaId           String? @map("area_id") @db.Uuid
  /// Set when this destination IS a province/city (Hanoi ↔ Thành phố Hà Nội): its places are that area's.
  representsAreaId String? @unique @map("represents_area_id") @db.Uuid
  /// Created by the catalog's boundary import (one per province/city); curated ones are false.
  autoCreated      Boolean @default(false) @map("auto_created")

  area           GeoArea?          @relation("DestinationArea", fields: [areaId], references: [id], onDelete: SetNull)
  representsArea GeoArea?          @relation("DestinationRepresents", fields: [representsAreaId], references: [id], onDelete: SetNull)
  places         Place[]
  trips          TripDestination[]
  posts          Post[]

  @@index([name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("destinations")
}

/// The canonical place the app shows. Imported places are merged from `place_sources`;
/// `id` never changes, so itineraries and saved places survive re-imports and merges.
model Place {
  id              String                                 @id @default(uuid()) @db.Uuid
  /// Local (on-the-ground) name. Translations live in `place_names`.
  name            String
  /// Accent-free, lower-cased name used for matching.
  nameNorm        String                                 @default("") @map("name_norm")
  /// Coarse type the itinerary UI uses; derived from `categoryId` for imported places.
  category        ItemType
  categoryId      String?                                @map("category_id") @db.Uuid
  /// Curated destination page this place belongs to, if any.
  destinationId   String?                                @map("destination_id") @db.Uuid
  /// Smallest administrative area containing the place.
  areaId          String?                                @map("area_id") @db.Uuid
  address         String                                 @default("")
  lat             Float
  lng             Float
  /// geography(Point) kept in sync with lat/lng by a trigger (migration 20261005000000_catalog).
  location        Unsupported("geography(Point, 4326)")?
  phone           String?
  website         String?
  /// OSM opening_hours syntax, e.g. "Mo-Su 07:00-22:00".
  openingHours    String?                                @map("opening_hours")
  rating          Float?
  status          PlaceStatus                            @default(ACTIVE)
  /// 0–1: how many sources confirm it and how complete it is.
  qualityScore    Float                                  @default(0) @map("quality_score")
  /// Fields an admin edited by hand; imports never overwrite them.
  lockedFields    String[]                               @default([]) @map("locked_fields")
  /// Which provider supplied each published field, e.g. {"name":"overture","phone":"osm"}.
  fieldSources    Json                                   @default("{}") @map("field_sources")
  mergedIntoId    String?                                @map("merged_into_id") @db.Uuid
  lastSeenAt      DateTime?                              @map("last_seen_at")
  searchText      String                                 @default("") @map("search_text")
  /// Same text lower-cased but WITH accents, so a query typed with diacritics can tell "phở" from "phố".
  searchAccent    String                                 @default("") @map("search_accent")
  /// When catalog_photos last looked for photos of this place; cleared by a trigger when the name or position changes.
  /// Published fields must be recomputed by the pipeline (set after an admin merge / unmerge).
  needsPublish    Boolean                                @default(false) @map("needs_publish")
  photosCheckedAt DateTime?                              @map("photos_checked_at")
  createdAt       DateTime                               @default(now()) @map("created_at")
  updatedAt       DateTime                               @default(now()) @updatedAt @map("updated_at")

  destination      Destination?     @relation(fields: [destinationId], references: [id])
  area             GeoArea?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  categoryRef      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mergedInto       Place?           @relation("PlaceMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom       Place[]          @relation("PlaceMerges")
  items            ItineraryItem[]
  savedBy          SavedPlace[]
  sources          PlaceSource[]
  names            PlaceName[]
  photos           PlacePhoto[]
  mergeCandidatesA MergeCandidate[] @relation("MergeCandidateA")
  mergeCandidatesB MergeCandidate[] @relation("MergeCandidateB")
  mergesWon        PlaceMerge[]     @relation("MergeWinner")
  mergesLost       PlaceMerge[]     @relation("MergeLoser")
  edits            PlaceEdit[]

  @@index([destinationId])
  @@index([areaId, categoryId, status])
  @@index([nameNorm])
  @@index([location], map: "places_location_gist", type: Gist)
  @@index([lat, lng])
  @@index([name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([updatedAt(sort: Desc), id]) // admin place list: newest first, without sorting the whole catalog
  // Partial / expression indexes Prisma can't describe live only in their SQL migrations (keep them when generating
  // a new migration): places_needs_publish_idx, places_listable_rank_idx, places_area_rank_idx,
  // places_area_category_idx, places_name_c_idx — see 20261014000000_* … 20261014000003_* — and
  // places_search_unfilled_idx (20261021000000_*).
  @@map("places")
}

// ── Trips ────────────────────────────────────────────────────────────────
model Trip {
  id              String         @id @default(uuid()) @db.Uuid
  ownerId         String         @map("owner_id") @db.Uuid
  title           String
  description     String         @default("")
  startDate       DateTime?      @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  visibility      TripVisibility @default(PRIVATE)
  allowComments   Boolean        @default(true) @map("allow_comments")
  allowFork       Boolean        @default(true) @map("allow_fork")
  estimatedBudget Int?           @map("estimated_budget")
  currency        String         @default("USD")
  coverA          String         @map("cover_a")
  coverB          String         @map("cover_b")
  coverMediaId    String?        @map("cover_media_id") @db.Uuid
  forkedFromId    String?        @map("forked_from_id") @db.Uuid
  /// Denormalised attribution — survives even if the source trip is later deleted.
  forkedFromTitle String?        @map("forked_from_title")
  forkedFromOwner String?        @map("forked_from_owner")
  forkCount       Int            @default(0) @map("fork_count")
  saveCount       Int            @default(0) @map("save_count")
  /// Accent-free "title description destinations" for fuzzy search.
  searchText      String         @default("") @map("search_text")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  owner        User              @relation("TripOwner", fields: [ownerId], references: [id])
  cover        Media?            @relation("TripCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  forkedFrom   Trip?             @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Trip[]            @relation("Forks")
  destinations TripDestination[]
  members      TripMember[]
  invitations  TripInvitation[]
  days         TripDay[]
  items        ItineraryItem[]
  events       TripEvent[]
  expenses     Expense[]
  settlements  Settlement[]
  posts        Post[]
  savedBy      SavedTrip[]

  @@index([ownerId])
  @@index([visibility, deletedAt])
  @@index([updatedAt])
  @@index([forkedFromId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("trips")
}

model TripDestination {
  tripId        String @map("trip_id") @db.Uuid
  destinationId String @map("destination_id") @db.Uuid
  position      Int

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@id([tripId, destinationId])
  @@index([destinationId])
  @@map("trip_destinations")
}

model TripMember {
  tripId   String    @map("trip_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     TripRole
  joinedAt DateTime  @default(now()) @map("joined_at")
  /// The part of the trip this member is there for (inclusive); null = from the start / to the end.
  arriveOn DateTime? @map("arrive_on") @db.Date
  leaveOn  DateTime? @map("leave_on") @db.Date

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// Only a SHA-256 hash of the invite token is stored. Tokens are never logged.
model TripInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  email      String?
  role       TripRole
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([email])
  @@index([invitedBy])
  @@map("trip_invitations")
}

model TripDay {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  dayNumber Int       @map("day_number")
  date      DateTime? @db.Date
  title     String?

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

/// Part of the day an item is planned for. Plans are flexible: only anchors (flights, bookings…)
/// carry a clock time; everything else sits in a slot, or ANY when it can happen whenever.
enum ItemSlot {
  MORNING
  AFTERNOON
  EVENING
  ANY
}

/// What actually happened to a planned item (set during the trip).
enum ItemStatus {
  PLANNED
  VISITED
  SKIPPED
}

/// A member's interest in an item of the trip — mostly used on the shared place pool.
enum VoteLevel {
  LOVE
  OK
  SKIP
}

model ItineraryItem {
  id           String     @id @default(uuid()) @db.Uuid
  tripId       String     @map("trip_id") @db.Uuid
  /// null = in the trip's place pool ("want to go if we can"), not yet on a day.
  dayId        String?    @map("day_id") @db.Uuid
  slot         ItemSlot   @default(ANY)
  status       ItemStatus @default(PLANNED)
  /// Who put it on the trip (credited on pool cards).
  addedById    String?    @map("added_by") @db.Uuid
  /// The item this one was copied from when the trip was remixed — how a fork shows what the
  /// original group actually did there ("visited · 4 loved it").
  sourceItemId String?    @map("source_item_id") @db.Uuid
  type         ItemType
  title        String
  description  String?
  placeId      String?    @map("place_id") @db.Uuid
  startTime    String?    @map("start_time")
  endTime      String?    @map("end_time")
  notes        String?
  /// Where the group meets up again after splitting (roadmap phase 2).
  meetup       Boolean    @default(false)
  sortOrder    Int        @map("sort_order")
  updatedById  String?    @map("updated_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day       TripDay?        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place     Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("ItemEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  addedBy   User?           @relation("ItemAdder", fields: [addedById], references: [id], onDelete: SetNull)
  votes     ItemVote[]
  source    ItineraryItem?  @relation("ItemSource", fields: [sourceItemId], references: [id], onDelete: SetNull)
  copies    ItineraryItem[] @relation("ItemSource")
  photos    ItemPhoto[]
  expenses  Expense[]
  assignees ItemAssignee[]

  @@index([dayId, sortOrder])
  @@index([tripId, dayId])
  @@map("itinerary_items")
}

/// Who is going to a stop when the group splits up (none = everyone).
model ItemAssignee {
  itemId String @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  item ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
  @@map("item_assignees")
}

/// A trip's own photos of a stop (memories for the recap), visible to whoever can see the trip.
model ItemPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  item     ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  media    Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  uploader User          @relation("ItemPhotoUploader", fields: [uploadedBy], references: [id])

  @@unique([itemId, mediaId])
  @@index([itemId, createdAt])
  @@map("item_photos")
}

enum ExpenseCategory {
  FOOD
  LODGING
  TRANSPORT
  ACTIVITY
  SHOPPING
  OTHER
}

/// Money spent on a trip, in the trip's currency, as an integer of its smallest unit (₫ 1, ¥ 1, $0.01).
/// Members only — never shown on public trips, never copied by a fork.
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  tripId      String          @map("trip_id") @db.Uuid
  paidById    String          @map("paid_by") @db.Uuid
  amount      BigInt
  description String
  category    ExpenseCategory @default(OTHER)
  spentOn     DateTime?       @map("spent_on") @db.Date
  /// The stop it was for (dinner at…), when there is one.
  itemId      String?         @map("item_id") @db.Uuid
  createdById String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  item      ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  shares    ExpenseShare[]

  @@index([tripId, spentOn])
  @@map("expenses")
}

/// Who owes what of an expense; the shares always add up to its amount.
model ExpenseShare {
  expenseId String @map("expense_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  amount    BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
  @@map("expense_shares")
}

/// A repayment between two members ("Minh paid An back 350 000 ₫").
model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  fromId      String   @map("from_user") @db.Uuid
  toId        String   @map("to_user") @db.Uuid
  amount      BigInt
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  from      User @relation("SettlementFrom", fields: [fromId], references: [id])
  to        User @relation("SettlementTo", fields: [toId], references: [id])
  createdBy User @relation("SettlementCreator", fields: [createdById], references: [id])

  @@index([tripId, createdAt])
  @@map("settlements")
}

model ItemVote {
  itemId    String    @map("item_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  level     VoteLevel
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  item ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
  @@map("item_votes")
}

/// Append-only log of what people do on a trip's plan (add, vote, move, visit, skip, edit…).
/// The product's behavioural record and the raw input for future planning suggestions; rows are
/// never updated. `payload` holds the event's facts (slot, day number, vote level…), never free text.
model TripEvent {
  id      BigInt   @id @default(autoincrement())
  tripId  String   @map("trip_id") @db.Uuid
  actorId String?  @map("actor_id") @db.Uuid
  /// Not a foreign key: the event outlives the item.
  itemId  String?  @map("item_id") @db.Uuid
  placeId String?  @map("place_id") @db.Uuid
  type    String
  payload Json     @default("{}")
  at      DateTime @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tripId, at])
  @@index([type, at])
  @@map("trip_events")
}

// ── Social ───────────────────────────────────────────────────────────────
model Post {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  tripId        String?        @map("trip_id") @db.Uuid
  destinationId String?        @map("destination_id") @db.Uuid
  title         String
  body          String         @default("")
  visibility    PostVisibility @default(PUBLIC)
  likeCount     Int            @default(0) @map("like_count")
  commentCount  Int            @default(0) @map("comment_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  user        User          @relation(fields: [userId], references: [id])
  trip        Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  destination Destination?  @relation(fields: [destinationId], references: [id])
  media       PostMedia[]
  placePhotos PlacePhoto[]
  likes       PostLike[]
  comments    PostComment[]
  savedBy     SavedPost[]

  @@index([userId])
  @@index([tripId])
  @@index([createdAt])
  @@index([visibility, deletedAt, createdAt])
  @@map("posts")
}

/// A post photo: either uploaded media, or (seed data) a generated palette.
model PostMedia {
  id       String  @id @default(uuid()) @db.Uuid
  postId   String  @map("post_id") @db.Uuid
  mediaId  String? @map("media_id") @db.Uuid
  paletteA String  @map("palette_a")
  paletteB String  @map("palette_b")
  position Int

  post  Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([mediaId])
  @@map("post_media")
}

model PostLike {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

model SavedTrip {
  userId    String   @map("user_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([userId, tripId])
  @@index([tripId])
  @@map("saved_trips")
}

model SavedPost {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_posts")
}

model SavedPlace {
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@map("saved_places")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  actorId      String?          @map("actor_id") @db.Uuid
  type         NotificationType
  /// English sentence (older rows, logs). `params` holds the NotificationMessage each reader's language is built from.
  text         String
  params       Json?
  tripId       String?          @map("trip_id") @db.Uuid
  postId       String?          @map("post_id") @db.Uuid
  invitationId String?          @map("invitation_id") @db.Uuid
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user  User  @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  target     ReportTarget
  targetId   String       @map("target_id") @db.Uuid
  reason     ReportReason
  details    String?
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, target, targetId])
  @@map("reports")
}

/// Binary data lives in object storage; only metadata is stored here (spec §32).
model Media {
  id            String   @id @default(uuid()) @db.Uuid
  /// null for images imported from open sources (owned by no user; see place_photos for credits).
  ownerId       String?  @map("owner_id") @db.Uuid
  storageKey    String   @unique @map("storage_key")
  thumbKey      String?  @map("thumb_key")
  mediumKey     String?  @map("medium_key")
  /// Average colour (#rrggbb) shown as a placeholder while the image loads.
  dominantColor String?  @map("dominant_color")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  width         Int
  height        Int
  createdAt     DateTime @default(now()) @map("created_at")

  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOf   UserProfile[] @relation("Avatar")
  coverOf    Trip[]        @relation("TripCover")
  postMedia  PostMedia[]
  placePhoto PlacePhoto[]
  itemPhotos ItemPhoto[]

  @@index([ownerId])
  @@map("media")
}

/// Sensitive permission changes (spec §42).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Place catalog (imported from open data by the Python pipeline in /pipelines) ──

/// Administrative areas: country → region (province / centrally-run city) → city → district.
model GeoArea {
  id          String                                       @id @default(uuid()) @db.Uuid
  parentId    String?                                      @map("parent_id") @db.Uuid
  level       GeoAreaLevel
  /// ISO 3166-1 alpha-2, e.g. "VN".
  countryCode String                                       @map("country_code")
  /// ISO 3166-2 where known, e.g. "VN-DN".
  isoCode     String?                                      @map("iso_code")
  /// Local name ("Đà Nẵng"); translations in geo_area_names.
  name        String
  slug        String                                       @unique
  timezone    String?
  /// Where the boundary came from ("overture", "manual") and its id there.
  source      String
  externalId  String?                                      @map("external_id")
  minLng      Float?                                       @map("min_lng")
  minLat      Float?                                       @map("min_lat")
  maxLng      Float?                                       @map("max_lng")
  maxLat      Float?                                       @map("max_lat")
  boundary    Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt   DateTime                                     @default(now()) @map("created_at")
  updatedAt   DateTime                                     @default(now()) @updatedAt @map("updated_at")

  parent       GeoArea?      @relation("AreaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     GeoArea[]     @relation("AreaTree")
  names        GeoAreaName[]
  places       Place[]
  destinations Destination[] @relation("DestinationArea")
  represented  Destination?  @relation("DestinationRepresents")
  sources      PlaceSource[]

  @@unique([source, externalId])
  @@index([parentId, level])
  @@index([countryCode, level])
  @@index([boundary], map: "geo_areas_boundary_gist", type: Gist)
  @@map("geo_areas")
}

model GeoAreaName {
  areaId String @map("area_id") @db.Uuid
  /// BCP 47 language tag ("vi", "en", "ja"…).
  lang   String
  name   String

  area GeoArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([areaId, lang])
  @@map("geo_area_names")
}

/// TRIPLY's own two-level taxonomy (e.g. food → food.cafe). Provider categories map onto it.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  key       String   @unique
  labelVi   String   @map("label_vi")
  labelEn   String   @map("label_en")
  itemType  ItemType @map("item_type")
  sortOrder Int      @default(0) @map("sort_order")

  parent   Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[]    @relation("CategoryTree")
  maps     CategoryMap[]
  places   Place[]
  sources  PlaceSource[]

  @@map("categories")
}

/// provider category → TRIPLY category. `external_category` is e.g. "cafe" (Overture) or "amenity=cafe" (OSM).
model CategoryMap {
  provider         String
  externalCategory String   @map("external_category")
  categoryId       String   @map("category_id") @db.Uuid
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([provider, externalCategory])
  @@map("category_maps")
}

/// One record as a provider published it. Re-imports upsert on (provider, external_id); unchanged
/// content (same content_hash) only bumps last_seen_at.
model PlaceSource {
  id              String                                 @id @default(uuid()) @db.Uuid
  placeId         String?                                @map("place_id") @db.Uuid
  provider        String
  externalId      String                                 @map("external_id")
  /// The provider's record, untouched.
  raw             Json
  /// Our normalised view of it (names by language, phone in E.164, category key…).
  normalized      Json
  contentHash     String                                 @map("content_hash")
  lat             Float
  lng             Float
  location        Unsupported("geography(Point, 4326)")?
  categoryId      String?                                @map("category_id") @db.Uuid
  areaId          String?                                @map("area_id") @db.Uuid
  license         String
  attribution     String
  /// "open" | "temporarily_closed" | "permanently_closed" as reported by the provider.
  operatingStatus String                                 @default("open") @map("operating_status")
  firstSeenAt     DateTime                               @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime                               @default(now()) @map("last_seen_at")
  lastRunId       String?                                @map("last_run_id") @db.Uuid
  /// Last run in which this record was new or its content/category changed (drives incremental publish).
  changedRunId    String?                                @map("changed_run_id") @db.Uuid
  /// Consecutive complete runs this record was absent from.
  missingRuns     Int                                    @default(0) @map("missing_runs")

  place    Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  area     GeoArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([placeId])
  @@index([provider, areaId])
  @@index([changedRunId])
  @@index([location], map: "place_sources_location_gist", type: Gist)
  @@map("place_sources")
}

model PlaceName {
  placeId String @map("place_id") @db.Uuid
  /// BCP 47 language tag; the local name is also stored under its own language.
  lang    String
  /// primary | alternate | short
  kind    String @default("primary")
  name    String
  source  String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, lang, kind])
  @@map("place_names")
}

/// One pipeline run (CLI, Airflow, a scheduled job or an admin's button).
model SyncRun {
  id              String    @id @default(uuid()) @db.Uuid
  /// "cli" | "airflow" | "admin" | "schedule" | "photos" | "dry_run"
  trigger         String
  /// { area, bbox, providers, category_keys, photos, dry_run, … }
  params          Json
  /// queued | running | succeeded | partial | needs_review | failed | cancelled
  status          String    @default("running")
  stats           Json      @default("{}")
  error           String?
  jobId           String?   @map("job_id") @db.Uuid
  /// {"total": 34, "done": 12, "failed": 1, "current": "osm/vn-da-nang"}
  progress        Json      @default("{}")
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  requestedById   String?   @map("requested_by") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  job         SyncJob?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  requestedBy User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  errors      SyncRunError[]
  cursors     SyncRunCursor[]

  @@index([startedAt])
  @@index([jobId, startedAt])
  @@index([status])
  @@map("sync_runs")
}

/// What an admin wants imported, and when: an area (or a box), sources, categories, a cron schedule (UTC).
/// The `catalog_scheduler` DAG starts due jobs; "Run now" starts one from the admin screen.
model SyncJob {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  /// Geo area slug ("vn", "vn-da-nang") or destination slug ("hoi-an").
  area         String?
  /// "minLng,minLat,maxLng,maxLat" instead of an area.
  bbox         String?
  providers    String[]  @default(["overture", "osm"])
  /// Empty = every category; otherwise TRIPLY group / category keys ("food", "sights.historic").
  categoryKeys String[]  @default([]) @map("category_keys")
  /// 5-field cron in UTC ("0 3 * * 1"); null = by hand only.
  schedule     String?
  enabled      Boolean   @default(true)
  photos       Boolean   @default(true)
  options      Json      @default("{}")
  nextRunAt    DateTime? @map("next_run_at")
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      SyncRun[]

  @@index([enabled, nextRunAt])
  @@map("sync_jobs")
}

/// Source categories with no mapping, counted in the background (catalog_refresh_unmapped()): counting them live
/// reads the jsonb of millions of records.
model CatalogUnmappedCategory {
  provider         String
  externalCategory String @map("external_category")
  records          Int

  @@id([provider, externalCategory])
  @@map("catalog_unmapped_categories")
}

/// When each background catalog summary was last computed (key "unmapped_categories").
model CatalogStat {
  key         String   @id
  refreshedAt DateTime @map("refreshed_at")

  @@map("catalog_stats")
}

/// How far each partition of a run got (resume after a crash). Written with the batch it describes.
model SyncRunCursor {
  runId        String   @map("run_id") @db.Uuid
  provider     String
  partitionKey String   @map("partition_key")
  /// Batches committed so far.
  batches      Int      @default(0)
  /// The last record id of the last committed batch — checked when skipping on resume.
  lastKey      String?  @map("last_key")
  done         Boolean  @default(false)
  /// The partition failed at least once (its failure is counted in progress until a retry succeeds).
  failed       Boolean  @default(false)
  /// fetched / inserted / changed so far.
  totals       Json     @default("{}")
  updatedAt    DateTime @default(now()) @map("updated_at")

  run SyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, provider, partitionKey])
  @@map("sync_run_cursors")
}

/// A record or a whole partition that failed in a run (the rest of the run went on).
model SyncRunError {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  provider   String?
  /// The record's id, or the partition key when a whole partition failed.
  externalId String?  @map("external_id")
  /// extract | load | publish | photos
  stage      String
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  run SyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("sync_run_errors")
}

/// An admin's change to a published field (the field is then locked against imports).
model PlaceEdit {
  id        String   @id @default(uuid()) @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  field     String
  old       Json?
  new       Json?
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([placeId, createdAt])
  @@map("place_edits")
}

/// A photo shown on a place page: uploaded by a TRIPLY user, or imported from an open source
/// (Wikimedia Commons) with the credits its licence requires. Imported rows start with `remoteUrl`
/// and no media; the API's photo ingester downloads and re-encodes them into `media`.
model PlacePhoto {
  id             String      @id @default(uuid()) @db.Uuid
  placeId        String      @map("place_id") @db.Uuid
  /// "user" | "wikimedia" (later "mapillary", "google").
  source         String
  /// Provider's id, e.g. "File:Chua Cau.jpg"; null for user photos.
  sourceId       String?     @map("source_id")
  mediaId        String?     @map("media_id") @db.Uuid
  remoteUrl      String?     @map("remote_url")
  pageUrl        String?     @map("page_url")
  title          String?
  author         String?
  authorUrl      String?     @map("author_url")
  license        String?
  licenseUrl     String?     @map("license_url")
  caption        String?
  status         PhotoStatus @default(PENDING)
  /// Ordering within a place (higher first): approved user photos, then a Wikidata item's main image, then quality images.
  score          Float       @default(0)
  uploadedById   String?     @map("uploaded_by_id") @db.Uuid
  postId         String?     @map("post_id") @db.Uuid
  reportCount    Int         @default(0) @map("report_count")
  ingestAttempts Int         @default(0) @map("ingest_attempts")
  ingestError    String?     @map("ingest_error")
  nextIngestAt   DateTime?   @map("next_ingest_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  place      Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media      Media? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  post       Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([placeId, source, sourceId])
  @@unique([placeId, mediaId])
  @@index([placeId, status, score])
  @@index([status, createdAt])
  @@index([mediaId])
  @@map("place_photos")
}

enum MergeStatus {
  PENDING
  MERGED
  REJECTED
}

/// Two places that may be the same (score between the review and auto thresholds), waiting for a decision.
/// `place_a < place_b` so a pair has one row. Written by the catalog pipeline; rejected pairs are never re-merged.
model MergeCandidate {
  id        String      @id @default(uuid()) @db.Uuid
  placeAId  String      @map("place_a") @db.Uuid
  placeBId  String      @map("place_b") @db.Uuid
  score     Float
  /// Per-signal scores and reasons, e.g. {"name": 0.92, "distance": 0.6, "category": 1, "blocked": "same_provider"}.
  signals   Json        @default("{}")
  status    MergeStatus @default(PENDING)
  /// "auto", "cli" or an admin's user id.
  decidedBy String?     @map("decided_by")
  decidedAt DateTime?   @map("decided_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  placeA Place @relation("MergeCandidateA", fields: [placeAId], references: [id], onDelete: Cascade)
  placeB Place @relation("MergeCandidateB", fields: [placeBId], references: [id], onDelete: Cascade)

  @@unique([placeAId, placeBId])
  @@index([placeBId])
  @@index([status, score])
  @@map("merge_candidates")
}

/// One merge: the loser points at the winner (`places.merged_into_id`), and `moved` lists what was moved so the
/// merge can be undone exactly.
model PlaceMerge {
  id        String    @id @default(uuid()) @db.Uuid
  winnerId  String    @map("winner_id") @db.Uuid
  loserId   String    @map("loser_id") @db.Uuid
  score     Float?
  signals   Json      @default("{}")
  moved     Json      @default("{}")
  actor     String
  createdAt DateTime  @default(now()) @map("created_at")
  undoneAt  DateTime? @map("undone_at")
  undoneBy  String?   @map("undone_by")

  winner Place @relation("MergeWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser  Place @relation("MergeLoser", fields: [loserId], references: [id], onDelete: Cascade)

  @@index([winnerId])
  @@index([loserId])
  @@map("place_merges")
}

/// Product analytics events (see migration 20261020000000_product_events). Facts only — never free text or PII.
model ProductEvent {
  id     BigInt   @id @default(autoincrement())
  type   String
  userId String?  @map("user_id") @db.Uuid
  /// Not a foreign key: the event outlives the trip.
  tripId String?  @map("trip_id") @db.Uuid
  props  Json     @default("{}")
  at     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([type, at])
  @@map("product_events")
}

