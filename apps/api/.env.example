# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://triply:triply@localhost:5432/triply
# Used only by `npm run test:int` (wiped between test runs)
TEST_DATABASE_URL=postgresql://triply:triply@localhost:5432/triply_test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Public URL of the web app (CORS + links in emails/invites)
WEB_ORIGIN=http://localhost:3000
# Cookies: set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false

# Media storage. "local" writes to MEDIA_DIR and the API serves /media/*.
# "s3" writes to an S3-compatible bucket (Cloudflare R2, Backblaze B2, MinIO, AWS S3) — use it on hosts
# without a persistent disk (Render Free, Fly without a volume). Then set the web's MEDIA_ORIGIN to MEDIA_PUBLIC_URL.
MEDIA_DRIVER=local
MEDIA_DIR=./storage/media
MEDIA_MAX_BYTES=8388608
# Cloudflare R2: R2 → bucket → Settings → Public access (r2.dev or a custom domain) gives MEDIA_PUBLIC_URL;
# R2 → Manage API tokens → "Object Read & Write" on that bucket gives the key pair; the S3 endpoint is
# https://<account id>.r2.cloudflarestorage.com. Copy existing local files up with `npm run media:push -w @triply/api`.
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=triply-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://pub-<hash>.r2.dev

# Google sign-in (optional — the button only appears when both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (defaults to WEB_ORIGIN + /api/v1/auth/google/callback)

# Mail: "dev-outbox" writes emails to MAIL_OUTBOX_DIR (never to logs)
MAIL_DRIVER=dev-outbox
MAIL_OUTBOX_DIR=./storage/outbox

# Rate limits (requests per minute per client IP) and which proxies may report the client IP.
# TRUST_PROXY: "loopback" when only the local Next.js server sits in front; in Docker
# "loopback, uniquelocal"; behind a load balancer its subnet or a hop count. Never "true".
# Put an edge in front that OVERWRITES X-Forwarded-For (deploy/nginx.conf, or Vercel).
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
TRUST_PROXY=loopback
