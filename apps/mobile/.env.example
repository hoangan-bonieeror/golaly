# Copy to .env (git-ignored). None of these are secrets: they are built into the app.

# Where Golaly runs. A phone can't reach "localhost": use your computer's LAN address while developing
# (the web dev server proxies /api/v1 to the API), and the web's public URL for real builds.
EXPO_PUBLIC_GOLALY_URL=http://192.168.1.10:3000

# Native Google sign-in (optional): OAuth client ids from Google Cloud Console.
# The web client id is the one the API's GOOGLE_CLIENT_ID uses; Android signs in with it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Written by `eas init`; needed for push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
