# Copy to .env (git-ignored). None of these are secrets: they are built into the app.

# Where Golaly runs. Leave it empty while developing: the app then uses the computer running Expo, port 3000
# (`npm run dev` — the web dev server proxies /api/v1 to the API). Set it for `expo start --tunnel`, to point
# a dev build at production (https://golaly.vercel.app), or if the web runs on another port.
EXPO_PUBLIC_GOLALY_URL=

# Native Google sign-in (optional): OAuth client ids from Google Cloud Console.
# The web client id is the one the API's GOOGLE_CLIENT_ID uses; Android signs in with it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Written by `eas init`; needed for push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
