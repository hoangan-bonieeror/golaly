# Where Next.js proxies /api/v1 and /media (server-side only)
API_ORIGIN=http://localhost:4000
# Where /media comes from when the API stores images in a bucket (MEDIA_DRIVER=s3): the bucket's public URL,
# same as the API's MEDIA_PUBLIC_URL. Leave empty for local media served by the API. Build-time (rewrites).
MEDIA_ORIGIN=
# Shared with the API's EDGE_SECRET (32+ chars): lets the API trust the visitor IP this app forwards. Runtime, server-side only.
EDGE_SECRET=
# Extra origins the browser may connect to (Content Security Policy), space-separated — e.g. a custom map style's tile host
CSP_CONNECT_EXTRA=
# Where the browser opens the realtime socket (the API's public URL)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Show the "act as demo user" switcher (development only; never enable in production)
NEXT_PUBLIC_DEMO_SWITCHER=true
# Map tiles (MapLibre style URL). Default: OpenFreeMap (free, no key). "off" = offline SVG map.
NEXT_PUBLIC_MAP_STYLE_URL=
